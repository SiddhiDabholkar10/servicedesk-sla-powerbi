model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Raw_Events","Incidents","Resolvers","SLA_Targets","First_Response","Group_Handoffs"]

annotation PBI_ProTooling = ["DevMode"]

ref table Incidents
ref table Resolvers
ref table SLA_Targets
ref table Date
ref table Group_Handoffs

ref cultureInfo en-US

