	partition Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2016, 1, 1 ), DATE ( 2017, 12, 31 ) ),   // fixed range: covers every ticket (Feb 2016 – Feb 2017)
				    "Year",         YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month",        FORMAT ( [Date], "MMM" ),
				    "Year-Month",   FORMAT ( [Date], "YYYY-MM" )
				)

	annotation PBI_Id = bb4a010850374e3794dcd3a6e011a6e5

