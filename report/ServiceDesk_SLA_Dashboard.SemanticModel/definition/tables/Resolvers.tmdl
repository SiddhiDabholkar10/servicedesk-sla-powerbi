table Resolvers
	lineageTag: 135e3df4-1ec8-414d-bdf8-ee6c7205ebe3

	column resolver_id
		dataType: int64
		formatString: 0
		lineageTag: f816dff1-cedf-4a18-839e-1480fd56d762
		summarizeBy: none
		sourceColumn: resolver_id

		annotation SummarizationSetBy = Automatic

	column 'Resolver Name'
		dataType: string
		lineageTag: c39636c5-d7d6-4982-9ab7-83022cc19a9b
		summarizeBy: none
		sourceColumn: Resolver Name

		annotation SummarizationSetBy = Automatic

	partition Resolvers = m
		mode: import
		source =
				let
				    // Reads the CSV file as raw text rows. Your file path is unchanged.
				    Source = Csv.Document(File.Contents("C:\Users\dabho\Downloads\incident+management+process+enriched+event+log\Resolvers.csv"),[Delimiter=",", Columns=2, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				
				    // Makes row 1 the column names: Column1 → resolved_by, Column2 → Resolver Name
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				
				    // Nested functions run inside-out: Text.AfterDelimiter ("Resolved by 11" → " 11"), then Text.Trim (" 11" → "11")
				    #"Resolver ID" = Table.TransformColumns(#"Promoted Headers",
				        {{"resolved_by", each Text.Trim(Text.AfterDelimiter(_, "by")), type text}}),
				
				    // Text "11" → number 11, matching the type of Incidents[resolver_id]
				    #"Resolver ID to Number" = Table.TransformColumnTypes(#"Resolver ID",
				        {{"resolved_by", Int64.Type}, {"Resolver Name", type text}}),
				
				    // Same column name as in Incidents, so the merge lines up clearly
				    #"Renamed Resolver" = Table.RenameColumns(#"Resolver ID to Number", {{"resolved_by", "resolver_id"}})
				in
				    #"Renamed Resolver"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

