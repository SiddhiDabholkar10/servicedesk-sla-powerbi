table Incidents
	lineageTag: f4d9ffcd-d396-4c10-9c22-f9740eb48890

	measure 'Total Tickets' = COUNTROWS ( Incidents )
		formatString: 0
		lineageTag: ae512b30-7004-45c5-a1e9-918c1c0ca234

	measure 'SLA Met' =
			
			CALCULATE (
			    COUNTROWS ( Incidents ),              // count tickets...
			    Incidents[ResolutionSLAMet] = TRUE () // ...but only those where the flag is TRUE
			)
			// CALCULATE = "do this calculation, but with an extra filter applied"
		formatString: 0
		lineageTag: 0181ef2c-35bf-4678-958f-0dbd58683f41

	measure 'Resolved Tickets' = COUNT ( Incidents[resolved_at] )
		formatString: 0
		lineageTag: 73d6fd11-5308-4dc8-9e9a-7f4ca0cc2442

	measure 'SLA Attainment %' =
			
			DIVIDE ( [SLA Met], [Resolved Tickets] )  // DIVIDE is safe division: returns blank instead of an error if dividing by 0
			// [Square brackets] with no table name = referencing another measure. Measures can build on each other.
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 86639c1f-2a23-4f10-a5e6-c4119dbd354d

		changedProperty = IsHidden

	measure 'Urgent Ticket %' =
			
			DIVIDE (
			    CALCULATE (
			        [Resolved Tickets],                 // reuse your existing measure...
			        SLA_Targets[priority_rank] <= 2     // ...but only Critical (1) and High (2)
			    ),                                      // the filter is on the dimension and flows to Incidents via the relationship
			    [Resolved Tickets]                      // ÷ all of this resolver's resolved tickets
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cf2b611c-db49-450c-9d96-fc6e92d7ae92

	measure 'Avg Priority Rank' =
			
			AVERAGEX (
			    FILTER ( Incidents, NOT ISBLANK ( Incidents[resolved_at] ) ),  // only resolved tickets, same set as the SLA %
			    RELATED ( SLA_Targets[priority_rank] )                         // each ticket's rank: 1 = Critical … 4 = Low
			)
		formatString: 0.00
		isHidden
		lineageTag: 18c98ba4-f58d-4c04-995b-0f0a67b51021

		changedProperty = IsHidden

	measure 'Responded On Time' =
			
			CALCULATE (
			    COUNTROWS ( Incidents ),
			    FILTER (
			        Incidents,
			        NOT ISBLANK ( Incidents[RespondedDate] )
			            && Incidents[RespondedDate] <= Incidents[RespondByDate]
			    )
			)
		formatString: 0
		lineageTag: 940be170-e923-42e8-bc77-3b6b53bbda3c

	measure 'Responded Tickets' =
			COUNT ( Incidents[RespondedDate] )
			// COUNT skips blanks, so only tickets that got a response are counted (same idea as Resolved Tickets)
		formatString: 0
		lineageTag: 2da5e1d5-c5c9-4337-bb1d-b1b56aa7b363

	measure 'Response SLA %' = DIVIDE ( [Responded On Time], [Responded Tickets] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9f5c628f-8a62-49bf-8582-c9aa7924615c

	measure 'Escalated Tickets' =
			
			CALCULATE (
			    [Total Tickets],                    // count tickets...
			    Incidents[reassignment_count] > 0   // ...that were handed off at least once
			)
		formatString: 0
		lineageTag: bdc2610d-9ddd-43f2-abaf-994c9d07a0f9

	measure 'Escalation Rate %' = DIVIDE ( [Escalated Tickets], [Total Tickets] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 078373f6-64fb-4011-8130-62994d4c22fd

	measure 'Avg Reassignments' = AVERAGE ( Incidents[reassignment_count] )
		formatString: 0.00
		lineageTag: 9f64002d-4a1b-491c-a364-6ed0658ada54

