	column ResolveByDate = Incidents[opened_at]  + RELATED ( SLA_Targets[resolution_target_hours] ) / 24
		formatString: General Date
		lineageTag: 9bebadc0-c6d0-4729-a9bf-a34f76dad1a0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column RespondByDate = ```
			
			Incidents[opened_at]
			    + RELATED ( SLA_Targets[response_target_hours] ) / 24 
			```
		formatString: General Date
		lineageTag: 69afc423-811b-4627-9772-d30178478406
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ResolutionSLAMet =
			
			VAR ResolvedTime = Incidents[resolved_at]        // VAR = store a value under a name to reuse below
			RETURN                                           // RETURN = the value this column actually gets
			    IF (
			        ISBLANK ( ResolvedTime ),                // no resolution date recorded?
			        BLANK (),                                // then leave it blank: unknown, not a breach
			        ResolvedTime <= Incidents[ResolveByDate] // otherwise TRUE if on time, FALSE if late
			    )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: aa13ced0-99bd-472b-ade2-83f17b1a9269
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Opened Date' =
			
			DATE (                              // DATE(year, month, day) builds a date with no time part
			    YEAR ( Incidents[opened_at] ),
			    MONTH ( Incidents[opened_at] ),
			    DAY ( Incidents[opened_at] )
			)
		formatString: Long Date
		lineageTag: b1526c91-9b51-44bf-9d2e-b2ebf2546c34
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column RespondedDate
		dataType: dateTime
		formatString: General Date
		lineageTag: 52f1fecd-783f-4146-8ac9-bc68e6e93da8
		summarizeBy: none
		sourceColumn: RespondedDate

		annotation SummarizationSetBy = Automatic

	column 'Handoff Bucket' =
			
			SWITCH (
			    TRUE (),                                   // pick the first condition that's true
			    Incidents[reassignment_count] = 0, "0",
			    Incidents[reassignment_count] = 1, "1",
			    Incidents[reassignment_count] = 2, "2",
			    "3+"                                       // anything else
			)
		lineageTag: 8a9142fc-1680-44d2-8361-c50cc30c244f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

